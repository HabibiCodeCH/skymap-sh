# TLS, compression and a small edge cache in front of uvicorn.
# Cloudflare in front of this absorbs the launch burst; Caddy is the origin.
#
# Uses a Cloudflare Origin CA cert (15-year validity) instead of automatic
# Let's Encrypt: with Cloudflare proxying permanently (orange cloud), Caddy
# never has a reachable path for an ACME renewal challenge, so Let's Encrypt
# would work once at bootstrap and then silently fail to renew ~60 days later.
# Generate the pair at Cloudflare dashboard -> SSL/TLS -> Origin Server, and
# set Cloudflare's SSL/TLS mode to Full (strict).
#
# Served on both https:// and http://, in separate blocks -- Caddy won't let
# one block mix a plain-HTTP address with TLS connection policies. Without
# the http:// block, Caddy's automatic-HTTPS feature treats this domain as
# HTTPS-only and 308s any plain HTTP request. That breaks the product's own
# flagship command: bare `curl skymap.sh` defaults to http:// and doesn't
# follow redirects by default, so it would silently print nothing. Public,
# read-only, no cookies/auth: serving it over plain HTTP too is a fine trade.
(shared) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {remote_host}
	}
	header {
		-Server
		Referrer-Policy no-referrer
	}
	log {
		output file /var/log/caddy/sky.log
		format json
	}
}

skymap.sh, www.skymap.sh {
	tls /etc/caddy/skymap-sh.pem /etc/caddy/skymap-sh.key
	import shared
}

http://skymap.sh, http://www.skymap.sh {
	import shared
}
