[Unit]
Description=skymap.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sky
WorkingDirectory=/srv/sky
Environment=PYTHONUNBUFFERED=1
# Workers share nothing -- the per-process rate limit and the /stats
# counters both multiply/fragment per worker, and Caddy's proxy routes by
# source IP with enough stickiness that two different visitors can land on
# two different workers and see two different, non-overlapping /stats
# totals. 1 worker means one shared counter and an honest rate limit,
# and ~180 req/s per core uncached is far more than this traffic needs.
# Raise this only alongside moving rate-limit/stats state to Redis.
ExecStart=/srv/sky/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/sky
MemoryMax=512M

[Install]
WantedBy=multi-user.target
